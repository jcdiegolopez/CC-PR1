let a: boolean = true;
let b: boolean = false;
let x: integer = 5;
print(a && b);
print(a || b);
print(!a);
print(!b && a);
print(x > 3);
print(x < 3);
print(x <= 5);
print(x >= 6);
print(x == 5);
print(x != 5);
print(x > 3 && x < 10 || b);
print(b || x == 4);
let r: integer = a ? 1 : 2;
print(r);
print(x < 3 ? 10 : 20);
let c: boolean = a == b;
print(c);
